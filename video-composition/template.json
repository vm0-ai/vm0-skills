{
  "schemaVersion": "1.0",
  "id": "navy-cobalt",
  "name": "this visual system",
  "domain": "News & Public Affairs",
  "styleVersion": "3.0",
  "kind": "open-visual-style",
  "status": "ready",
  "readyAt": "2026-09-03",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "visibleLanguage": "en",
  "compositionPolicy": "select-combine-mutate-or-invent",
  "palettePolicy": "variants-within-one-style",
  "designFamily": "palette",
  "templateFamilyId": "palette",
  "packageRole": "canonical-entry",
  "colorSystemPolicy": {
    "scope": "project",
    "selection": "one-name-propagated-to-host-and-all-scenes",
    "default": "navy-cobalt",
    "builtIn": [
      "navy-cobalt",
      "monumental-minimal",
      "black-gold",
      "obsidian-champagne",
      "petrol-brass",
      "parchment-oxblood",
      "porcelain-carbon"
    ],
    "legacyAliases": {
      "blue-white": "navy-cobalt",
      "white-blue": "monumental-minimal"
    },
    "custom": "complete-semantic-token-collection",
    "tokenPrefix": "--palette-",
    "geometryIndependent": true
  },
  "domainFit": [
    "national updates",
    "policy briefings",
    "institutional news",
    "public-service information"
  ],
  "domainAvoid": [
    "consumer lifestyle",
    "luxury campaigns",
    "playful product demos"
  ],
  "entrypoints": {
    "skill": "SKILL.md",
    "authoring": "references/AUTHORING.md",
    "fastRouter": "references/ROUTER.md",
    "presenterAdaptation": "references/PRESENTER-ADAPTATION.md",
    "voiceAvatar": "references/VOICE-AVATAR.md",
    "layoutCatalog": "references/LAYOUT-CATALOG.md",
    "hyperframesLayoutMap": "references/HYPERFRAMES-LAYOUT-MAP.md",
    "layoutGallery": "assets/layouts/index.html",
    "layoutContactSheet": "assets/layouts/contact-sheet.jpg",
    "style": "references/STYLE.md",
    "motion": "references/MOTION.md",
    "motionCatalog": "references/MOTION-CATALOG.md",
    "archetypes": "references/composition-archetypes/INDEX.md",
    "gallery": "assets/frames/index.html"
  },
  "assets": {
    "gsapRuntime": "assets/runtime/gsap.min.js",
    "frameStyles": "assets/frames/frame.css",
    "runtimeStyles": "assets/runtime/stage.css",
    "colorSystem": "assets/runtime/color-system.css",
    "customColorSystem": "assets/runtime/custom-color-system.css",
    "projectColorReceipt": ".style-reference/video-composition/COLOR-SYSTEM.json",
    "sceneStarter": "assets/starter/compositions/vc-scene.html",
    "presenterSceneStarter": "assets/starter/compositions/vc-presenter-scene.html",
    "hostWiringExample": "assets/starter/demo-index.html",
    "sceneScaffolder": "scripts/scaffold-scenes.mjs",
    "timingFinalizer": "scripts/finalize-timing.mjs",
    "colorSystemSetter": "scripts/set-color-system.mjs",
    "bootstrap": "scripts/bootstrap-project.mjs",
    "reviewScript": "scripts/review-project.mjs",
    "executableLayoutStarters": "assets/layouts/source",
    "layoutPreviews": "assets/layouts/preview",
    "layoutContactSheet": "assets/layouts/contact-sheet.jpg",
    "fonts": [
      "assets/fonts/body.woff2",
      "assets/fonts/editorial.woff2",
      "assets/fonts/condensed.woff2",
      "assets/fonts/mono.woff2"
    ],
    "presenterReferences": [
      "assets/presenters/p1.png",
      "assets/presenters/p2.png"
    ],
    "styleMasters": [
      "assets/style-master-a.png",
      "assets/style-master-b.png"
    ],
    "media": []
  },
  "recognitionAnchors": [
    "one dominant institutional field",
    "high-contrast decision surface",
    "restrained composition accent",
    "isolated deadline signal"
  ],
  "reviewPolicy": {
    "entrypoint": "scripts/review-project.mjs",
    "phases": [
      "preflight",
      "static",
      "preview",
      "release"
    ],
    "sampling": "derive-scene-midpoints-from-host",
    "preflight": "vc-contract-plus-hyperframes-lint",
    "previewCheck": "full-with-contrast-then-automatic-scene-delta",
    "releaseReuse": "successful-preview-when-source-fingerprint-is-unchanged",
    "render": "native-hyperframes-after-user-approval"
  },
  "registryIntegrationPolicy": {
    "receipt": ".style-reference/video-composition/REGISTRY-INSTALLS.json",
    "component": "fuse-official-source-into-scene-and-bake-starter-defaults",
    "block": "copy-official-source-per-scene-and-edit-marked-content",
    "guessing": "forbidden"
  },
  "fontPolicy": {
    "bundled": "latin",
    "nonLatin": "stage-user-supplied-licensed-content-font",
    "runtimeToken": "VcContent"
  },
  "voicePolicy": {
    "provider": "heygen",
    "identity": "one-voice-id-across-voice-and-talking-avatar-scenes",
    "voiceOnly": "direct-heygen-tts",
    "talkingAvatar": "embedded-heygen-voice-without-duplicate-tts",
    "billingBasis": "generated-seconds-and-engine-not-job-count"
  },
  "workflowPolicy": {
    "ownerWhenExplicitlySelected": "video-composition",
    "defaultPlanningArtifacts": [
      "BRIEF.md-when-required",
      "SOURCES.md-when-factual-research-requires-it"
    ],
    "inlineStarterSceneLimit": 12,
    "defaultPresenterMedia": [
      "assets/presenters/p1.png",
      "assets/presenters/p2.png"
    ],
    "imageGeneration": "only-when-user-explicitly-requests-a-new-identity-or-custom-image"
  },
  "contentFitPolicy": {
    "priority": [
      "complete-official-content",
      "readable-scale",
      "centered-settled-state",
      "video-presenter-intent",
      "scene-presenter-fit",
      "optional-content-bearing-chrome"
    ],
    "defaultAlignment": "center-both-axes",
    "defaultTitleChrome": "omitted",
    "fullCanvasBlockHost": "1920x1080-unclipped",
    "overflowResolution": "use-grounded-head-shoulders-or-move-presenter-then-reselect-or-split-never-shrink-full-presenter"
  },
  "presenterGrammar": {
    "mediaSelector": ".presenter-media",
    "geometrySelector": ".presenter-slot",
    "backgroundBinding": "video-choice-with-scene-level-presence",
    "treatments": [
      "integrated",
      "territory",
      "framed",
      "portal"
    ],
    "defaultTreatment": "integrated",
    "videoModeAttribute": "data-video-presenter",
    "videoModes": [
      "off",
      "on"
    ],
    "defaultVideoMode": "unresolved",
    "resolutionPolicy": "use-explicit-user-choice-or-ask-once-before-scene-planning",
    "offMode": "omit-all-presenter-dom-and-use-full-safe-frame",
    "onMode": {
      "scenePresence": "optional-per-scene-after-content-review",
      "recurrence": "narrative-judgment-without-scene-count-quota",
      "distribution": "separate-appearances-when-the-explanation-benefits"
    },
    "scenePresenceAttribute": "data-presenter",
    "mediaKindAttribute": "data-presenter-media",
    "mediaKinds": [
      "static",
      "talking-avatar"
    ],
    "talkingAvatar": {
      "definition": "generated-speaking-video-not-bundled-static-png",
      "durationPolicy": "measured-media-duration-wins",
      "videoPlayback": "muted-framework-owned",
      "audioPlayback": "separate-unique-id-framework-owned-track",
      "partialRegionBackground": "transparent-or-background-removed"
    },
    "sceneLayoutAttribute": "data-presenter-layout",
    "sceneLayouts": [
      "divider-left",
      "divider-right",
      "side-left",
      "side-right",
      "corner-left",
      "corner-right"
    ],
    "representationPreference": [
      "complete-full-presenter-at-template-standard-size",
      "grounded-bottom-corner-head-shoulders",
      "presenter-led-divider",
      "presenter-free"
    ],
    "fullCanvasCoexistence": "never-share-scene-use-presenter-free-content-and-a-nearby-presenter-led-scene",
    "cropVocabulary": [
      "full",
      "head-shoulders"
    ],
    "defaultCrop": "full",
    "fullPresenterSize": "fixed-by-template",
    "fullPresenterScalePolicy": "never-downscale-to-force-coexistence",
    "headShouldersPolicy": {
      "layouts": [
        "corner-left",
        "corner-right"
      ],
      "verticalAnchor": "bottom-edge",
      "boundary": "soft-transparent-circular-fade",
      "requiredVisibleFeatures": [
        "face",
        "neck",
        "shoulders"
      ]
    },
    "faceSafety": {
      "requiredVisibleFeatures": [
        "forehead",
        "eyes",
        "mouth",
        "chin"
      ],
      "preferredInput": "face-box-or-alpha-bounds"
    }
  },
  "archetypes": [
    {
      "id": "national-brief",
      "name": "National Brief",
      "intents": [
        "identity",
        "headline",
        "presenter-led"
      ],
      "density": "low",
      "presenter": "optional",
      "previewPresenter": "present",
      "approvedStyleMaster": true,
      "card": "references/composition-archetypes/national-brief.md",
      "source": "assets/frames/source/national-brief.html",
      "preview": "assets/frames/preview/national-brief.png",
      "previewPresenterTreatment": "integrated",
      "previewPresenterCrop": "full"
    },
    {
      "id": "decision-deadline",
      "name": "Decision Deadline",
      "intents": [
        "explanation",
        "evidence",
        "state-change"
      ],
      "density": "low-medium",
      "presenter": "optional",
      "previewPresenter": "omitted",
      "approvedStyleMaster": true,
      "card": "references/composition-archetypes/decision-deadline.md",
      "source": "assets/frames/source/decision-deadline.html",
      "preview": "assets/frames/preview/decision-deadline.png"
